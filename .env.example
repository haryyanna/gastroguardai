# Copy this file to .env in the project root for local development.
# Keep real credentials in .env or your hosting provider's secret manager.

# Server-side secrets: never rename these to VITE_*.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
NEON_DATABASE_URL=

# Set true only if FatSecret has enabled the localization scope for your account.
FATSECRET_USE_LOCALIZATION=false

# Public browser configuration. Values prefixed with VITE_ are included in the built website.
VITE_API_BASE_URL=
VITE_NEON_ENABLED=true

# Firebase web-app configuration (client-visible; secure it with Firebase rules and API restrictions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase project URL and public anon key only. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# This value is bundled into the browser. Use only a webhook designed for public client access.
VITE_SHEETS_WEBHOOK_URL=
VITE_SHEETS_SOURCE_LABEL=moodify-web

# Do not add VITE_GEMINI_API_KEY or VITE_CEREBRAS_API_KEY.
# AyuScan and GastroBot use the server-side GEMINI_API_KEY through the API.
